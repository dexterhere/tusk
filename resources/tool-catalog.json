{
  "$comment": "when = stack tags from uat_detect.py ('*' = always). install.method: builtin|pip|npm|docker|cargo|system. Pip/npm/cargo install into <repo>/.uat/tools; docker images pull lazily on first run. run uses $UAT_BASE_URL, $UAT_WS.",
  "tools": [
    {"name": "playwright", "kind": "ui", "license": "Apache-2.0", "when": ["web-ui"], "install": {"method": "builtin", "spec": "npm-playwright via mise"}, "check": "playwright --version", "run": "playwright test --reporter=line", "notes": "journey lens. Prefer a test file as repro; traces on failure."},
    {"name": "hurl", "kind": "api", "license": "Apache-2.0", "when": ["api"], "install": {"method": "system", "spec": "sudo pacman -S hurl  (or: cargo install hurl)"}, "check": "hurl --version", "run": "hurl --test --variable base=$UAT_BASE_URL flow.hurl", "notes": "API flow scripts; asserts make exit code the oracle."},
    {"name": "schemathesis", "kind": "api-fuzz", "license": "MIT", "when": ["openapi"], "install": {"method": "pip", "spec": "schemathesis"}, "check": "st --version", "run": "st run $UAT_BASE_URL/openapi.json --checks all --max-examples 50 --seed 1", "notes": "breaker lens; pin --seed in the repro."},
    {"name": "hypothesis", "kind": "property", "license": "MPL-2.0", "when": ["python"], "install": {"method": "pip", "spec": "hypothesis pytest"}, "check": "python -c 'import hypothesis'", "run": "pytest -x test_props.py", "notes": "Property tests; derandomize in the repro."},
    {"name": "fast-check", "kind": "property", "license": "MIT", "when": ["node"], "install": {"method": "npm", "spec": "fast-check"}, "check": "node -e \"require('fast-check')\"", "run": "node props.js", "notes": "Set seed in the repro."},
    {"name": "k6", "kind": "load", "license": "AGPL-3.0", "when": ["api", "web-ui"], "install": {"method": "docker", "spec": "grafana/k6"}, "check": "docker image inspect grafana/k6", "run": "docker run --rm --network host -i grafana/k6 run - < load.js", "notes": "resilience lens. Small VUs only (RAM)."},
    {"name": "toxiproxy", "kind": "fault", "license": "MIT", "when": ["api", "web-ui", "docker"], "install": {"method": "docker", "spec": "ghcr.io/shopify/toxiproxy"}, "check": "docker image inspect ghcr.io/shopify/toxiproxy", "run": "docker run -d --network host ghcr.io/shopify/toxiproxy", "notes": "Latency/drops between app and dependencies."},
    {"name": "wiremock", "kind": "mock", "license": "Apache-2.0", "when": ["api", "web-ui"], "install": {"method": "docker", "spec": "wiremock/wiremock"}, "check": "docker image inspect wiremock/wiremock", "run": "docker run -d -p 8089:8080 wiremock/wiremock", "notes": "Stub third-party HTTP APIs."},
    {"name": "mockoon", "kind": "mock", "license": "MIT", "when": ["api", "web-ui"], "install": {"method": "docker", "spec": "mockoon/cli"}, "check": "docker image inspect mockoon/cli", "run": "docker run -d -p 3001:3001 mockoon/cli -d <file>", "notes": "Alternative mock server."},
    {"name": "localstack", "kind": "mock", "license": "check-account-terms", "when": ["aws"], "optional": true, "install": {"method": "docker", "spec": "localstack/localstack"}, "check": "docker image inspect localstack/localstack", "run": "docker run -d -p 4566:4566 localstack/localstack", "notes": "Free tier may need an account/token and be non-commercial. Verify first; moto is the fallback."},
    {"name": "semgrep", "kind": "static", "license": "LGPL-2.1", "when": ["*"], "install": {"method": "docker", "spec": "semgrep/semgrep"}, "check": "docker image inspect semgrep/semgrep", "run": "docker run --rm -v $UAT_WS:/src semgrep/semgrep semgrep --config p/default --json /src", "notes": "Leads only. Use community rules."},
    {"name": "gitleaks", "kind": "secrets", "license": "MIT", "when": ["*"], "install": {"method": "docker", "spec": "zricethezav/gitleaks"}, "check": "docker image inspect zricethezav/gitleaks", "run": "docker run --rm -v $UAT_WS:/path zricethezav/gitleaks detect --no-git -s /path", "notes": "Leads only."},
    {"name": "trivy", "kind": "deps", "license": "Apache-2.0", "when": ["*"], "install": {"method": "docker", "spec": "aquasec/trivy"}, "check": "docker image inspect aquasec/trivy", "run": "docker run --rm -v $UAT_WS:/src aquasec/trivy fs --scanners vuln,misconfig /src", "notes": "Dependency and misconfig leads."},
    {"name": "zap", "kind": "websec", "license": "Apache-2.0", "when": ["web-ui", "api"], "install": {"method": "docker", "spec": "ghcr.io/zaproxy/zaproxy:stable"}, "check": "docker image inspect ghcr.io/zaproxy/zaproxy:stable", "run": "docker run --rm --network host ghcr.io/zaproxy/zaproxy:stable zap-baseline.py -t $UAT_BASE_URL", "notes": "Baseline (passive) scan only. Never against anything but the UAT env."},
    {"name": "axe", "kind": "a11y", "license": "MPL-2.0", "when": ["web-ui"], "install": {"method": "npm", "spec": "@axe-core/cli"}, "check": "axe --version", "run": "axe $UAT_BASE_URL --exit", "notes": "Exit code is the oracle."},
    {"name": "pa11y", "kind": "a11y", "license": "LGPL-3.0", "when": ["web-ui"], "install": {"method": "npm", "spec": "pa11y"}, "check": "pa11y --version", "run": "pa11y $UAT_BASE_URL", "notes": "Second a11y opinion."},
    {"name": "lighthouse", "kind": "perf", "license": "Apache-2.0", "when": ["web-ui"], "install": {"method": "npm", "spec": "lighthouse"}, "check": "lighthouse --version", "run": "lighthouse $UAT_BASE_URL --quiet --chrome-flags='--headless' --output json", "notes": "Needs Chrome; assert score thresholds in the repro."},
    {"name": "coverage-py", "kind": "coverage", "license": "Apache-2.0", "when": ["python"], "install": {"method": "pip", "spec": "coverage"}, "check": "python -c 'import coverage'", "run": "coverage run -m pytest && coverage json", "notes": "Aims charters at untested flows."},
    {"name": "c8", "kind": "coverage", "license": "ISC", "when": ["node"], "install": {"method": "npm", "spec": "c8"}, "check": "c8 --version", "run": "c8 --reporter=json npm test", "notes": "Aims charters at untested flows."},
    {"name": "cargo-llvm-cov", "kind": "coverage", "license": "Apache-2.0", "when": ["rust"], "install": {"method": "cargo", "spec": "cargo-llvm-cov"}, "check": "cargo llvm-cov --version", "run": "cargo llvm-cov --json", "notes": "Needs llvm-tools-preview."},
    {"name": "mutmut", "kind": "mutation", "license": "BSD-3-Clause", "when": ["python"], "install": {"method": "pip", "spec": "mutmut"}, "check": "mutmut --version", "run": "mutmut run", "notes": "Run only in /uat-feedback on touched modules (slow)."},
    {"name": "stryker", "kind": "mutation", "license": "Apache-2.0", "when": ["node"], "install": {"method": "npm", "spec": "@stryker-mutator/core"}, "check": "stryker --version", "run": "stryker run", "notes": "Slow. Scope to touched files."},
    {"name": "cargo-mutants", "kind": "mutation", "license": "MIT", "when": ["rust"], "install": {"method": "cargo", "spec": "cargo-mutants"}, "check": "cargo mutants --version", "run": "cargo mutants --in-diff", "notes": "Slow. Scope with --in-diff."},
    {"name": "faker", "kind": "data", "license": "MIT", "when": ["python"], "install": {"method": "pip", "spec": "faker"}, "check": "python -c 'import faker'", "run": "python seed.py", "notes": "Seed data. Fixed seed for reproducibility."},
    {"name": "libfaketime", "kind": "time", "license": "GPL-2.0", "when": ["*"], "install": {"method": "system", "spec": "sudo pacman -S libfaketime"}, "check": "test -e /usr/lib/faketime/libfaketime.so.1", "run": "LD_PRELOAD=/usr/lib/faketime/libfaketime.so.1 FAKETIME='+30d' <cmd>", "notes": "Expiry, TTL and scheduling bugs."}
  ]
}
